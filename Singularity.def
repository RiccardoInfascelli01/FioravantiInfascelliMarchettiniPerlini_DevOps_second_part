Bootstrap: docker
From: ubuntu:22.04

%post

    # Set noninteractive mode for apt-get
    export DEBIAN_FRONTEND=noninteractive

    # Installa strumenti di compilazione e dipendenze base
    apt-get update && apt-get install -y \
        g++ \
        build-essential \
        cmake \
        git \
        python3 \
        python3-pip

    # Clone the repo inside the container
    cd /usr
    git clone --recursive https://github.com/RiccardoInfascelli01/FioravantiInfascelliMarchettiniPerlini_DevOps_second_part.git

    # Build
    cd /usr/FioravantiInfascelliMarchettiniPerlini_DevOps_second_part/
    ./build.sh

%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"
    echo "Running grayscale converter..."
    cd /usr/FioravantiInfascelliMarchettiniPerlini_DevOps_second_part
    ./convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"
