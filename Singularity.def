Bootstrap: docker
From: ubuntu:22.04

%labels
    Authors "Fioravanti, Infascelli, Marchettini, Perlini"
    Version "v1.0"

%post
    # Aggiorna pacchetti base
    apt-get update && apt-get install -y \
        software-properties-common \
        build-essential \
        cmake \
        git \
        libgtest-dev \
        python3 \
        python3-pip \
        golang-go

    # Aggiungi repository toolchain aggiornata
    add-apt-repository ppa:ubuntu-toolchain-r/test -y
    apt-get update

    # Installa gcc/g++ 12
    apt-get install -y gcc-12 g++-12

    # Imposta gcc-12 e g++-12 come default
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100

    # Build GTest
    cd /usr/src/gtest && cmake . && make && cp lib/*.a /usr/lib

    # Crea cartella progetto
    mkdir -p /app
    chown -R root:root /app

    # Compila il progetto usando gcc-12/g++-12
    cd /app
    chmod +x build.sh
    ./build.sh

%files
    . /app

%environment
    export PATH=/app:$PATH
    export HOME=/app

%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"
    echo "Running grayscale converter..."
    cd /app
    ./convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"
