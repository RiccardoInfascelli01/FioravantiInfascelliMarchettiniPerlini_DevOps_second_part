Bootstrap: docker
From: ubuntu:22.04


%files
    src /app/src
    include /app/include
    external /app/external
    build.sh /app/build.sh
    CMakeLists.txt /app/CMakeLists.txt


%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        g++ \
        build-essential \
        cmake \
        git \
        python3 \
        python3-pip

    cd /app    
    rm -rf build
    chmod +x build.sh
    ./build.sh

%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"
    echo "Running grayscale converter..."
    cd /app
    ./convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"

