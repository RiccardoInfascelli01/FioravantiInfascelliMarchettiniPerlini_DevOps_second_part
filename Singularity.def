Bootstrap: docker
From: ubuntu:22.04

%files
    . /app

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        g++ \
        build-essential \
        cmake \
        git \
        python3 \
        python3-pip \

    pip3 install --upgrade pip
    pip3 install -r /app/requirements.txt

    cd /app
    rm -rf build
    chmod +x build.sh
    ./build.sh

%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"

    echo "Running grayscale converter..."

    /app/convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"
