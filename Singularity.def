Bootstrap: docker
From: ubuntu:22.04

%labels
    Authors "Fioravanti, Infascelli, Marchettini, Perlini"
    Version "v1.0"

%post
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        git \
        libgtest-dev \
        python3 \
        python3-pip \
        golang-go  # se usi Go, vedi sotto

    # Build GTest
    cd /usr/src/gtest && cmake . && make && cp lib/*.a /usr/lib

    # Crea cartella progetto
    mkdir -p /app
    chown -R root:root /app

%files
    . /app  # copia tutto dentro /app

%environment
    export PATH=/app/bin:$PATH
    export HOME=/app

%runscript
    echo "Running grayscale converter..."
    cd /app
    ./bin/convert_image input.ppm output.pgm
