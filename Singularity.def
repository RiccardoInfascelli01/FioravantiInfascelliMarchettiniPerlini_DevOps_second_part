Bootstrap: docker
From: ubuntu:22.04

%post
    # Installa strumenti di compilazione e dipendenze base
    apt-get update && apt-get install -y \
        g++ \
        build-essential \
        cmake \
        git \
        python3 \
        python3-pip \
        wget

    # Crea cartella per il progetto
    mkdir -p /app
    chown -R root:root /app

    # Copia i file del progetto
%files
    . /app

%post
    # Compilazione manuale dentro il container
    cd /app
    g++ -std=c++17 -O2 -Wall -Wextra -Iinclude src/main.cpp src/image_processing.cpp -o convert_grayscale

%environment
    export PATH=/usr/bin:$PATH
    export HOME=/app

%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"
    echo "Running grayscale converter..."
    cd /app
    ./convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"
