Bootstrap: docker
From: ubuntu:22.04

%post
    # Aggiorna pacchetti base
    apt-get update && apt-get install -y \
        software-properties-common \
        build-essential \
        cmake \
        git \
        libgtest-dev \
        python3 \
        python3-pip \
        golang-go \
        wget \
        libgmp-dev \
        libmpfr-dev \
        libmpc-dev \
        flex \
        bison

    # Scarica e compila GCC 13.2.0
    cd /opt
    wget https://ftp.gnu.org/gnu/gcc/gcc-13.2.0/gcc-13.2.0.tar.gz
    tar -xzf gcc-13.2.0.tar.gz
    cd gcc-13.2.0
    ./contrib/download_prerequisites
    mkdir build && cd build
    ../configure --disable-multilib --enable-languages=c,c++
    make -j$(nproc)
    make install

    # Aggiorna i link simbolici per gcc e g++
    update-alternatives --install /usr/bin/gcc gcc /usr/local/bin/gcc 100
    update-alternatives --install /usr/bin/g++ g++ /usr/local/bin/g++ 100

    # Verifica la versione di gcc e g++
    gcc --version
    g++ --version

    # Crea cartella progetto
    mkdir -p /app
    chown -R root:root /app

    # Copia i file del progetto
%files
    . /app

%post
    # Compila il progetto usando gcc-13.2.0/g++-13.2.0
    cd /app
    chmod +x build.sh
    ./build.sh

%environment
    export PATH=/usr/local/bin:$PATH
    export HOME=/app

%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"
    echo "Running grayscale converter..."
    cd /app
    ./convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"
