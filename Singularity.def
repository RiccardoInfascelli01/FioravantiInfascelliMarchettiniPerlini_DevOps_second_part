Bootstrap: docker
From: ubuntu:22.04


%files
    . /app

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        g++ \
        build-essential \
        cmake \
        git \
        python3 \
        python3-pip

    # Copia /app in una directory temporanea per la build
    mkdir -p /tmp/build_dir
    cp -r /app/* /tmp/build_dir/
    cd /tmp/build_dir
    rm -rf build
    chmod +x build.sh
    ./build.sh

    # Poi sposta il binario compilato dove vuoi (es. /usr/local/bin)
    cp convert_grayscale /g100/home/userexternal/rinfasce/grayscale_output


%runscript
    INPUT_ARG="$1"
    OUTPUT_ARG="$2"
    OPERATION_MODE="$3"
    echo "Running grayscale converter..."
    cd /g100/home/userexternal/rinfasce/grayscale_output
    ./convert_grayscale "$INPUT_ARG" "$OUTPUT_ARG" "$OPERATION_MODE"

